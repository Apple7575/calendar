+  static func exifOrientation(mediaInfo: MediaInfo) -> Int? {
+    guard let original = mediaInfo[.originalImage] as? UIImage else {
+      return nil
+    }
+    switch original.imageOrientation {
+    case .up: return 1
+    case .upMirrored: return 2
+    case .down: return 3
+    case .downMirrored: return 4
+    case .leftMirrored: return 5
+    case .right: return 6
+    case .rightMirrored: return 7
+    case .left: return 8
+    @unknown default: return nil
+    }
+  }
