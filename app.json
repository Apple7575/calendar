{
  "expo": {
    "name": "나의 캘린더",
    "slug": "calendar-app",
    "version": "1.0.0",
    "scheme": "calendarapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7C6BE8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.newblueday.mycalendar",
      "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "수면 시간을 일기에 자동으로 기록하기 위해 건강 데이터를 읽습니다.",
        "NSHealthUpdateUsageDescription": "건강 데이터를 수정하지 않습니다."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": ["group.com.newblueday.mycalendar"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7C6BE8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "일기에 넣을 사진을 선택하기 위해 사진 보관함에 접근합니다."
        }
      ],
      "expo-font",
      "@bacons/apple-targets"
    ],
    "extra": {
      "supabaseUrl": "https://qlurqptsnvxvlbsvpjie.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFsdXJxcHRzbnZ4dmxic3ZwamllIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODM0ODg2NjEsImV4cCI6MjA5OTA2NDY2MX0.rQhKMJAZ10hUClgLbmDR6qejnhPQo8dxCR3Qe8Pur9c",
      "eas": {
        "projectId": "389de53e-8eb9-49bf-962c-b63d9a09bcdd"
      }
    }
  }
}
